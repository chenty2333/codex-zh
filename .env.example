# The launcher DOES NOT automatically source this file.
# Prefer the OS keyring; alternatively export DEEPSEEK_API_KEY in your shell.
# Never commit a real API key.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
CODEX_ZH_TIMEOUT_MS=60000
CODEX_ZH_BATCH_CHARS=1800
# CODEX_ZH_STATE_DIR=/your/private/local/state/directory
# CODEX_ZH_PASSTHROUGH=1
